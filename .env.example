# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Database (Prisma) ----------
# Pooled connection string used at runtime
DATABASE_URL=
# Direct connection string used by Prisma migrations
DIRECT_URL=

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Seed admin (optional) ----------
SEED_ADMIN_EMAIL=
SEED_ADMIN_ID=

# ---------- Webhook ----------
WEBHOOK_SECRET=

# ---------- Push Notifications (VAPID) ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- AI Features (OpenAI-compatible) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_ENABLED=true

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@lightandsalt.church
EMAIL_FROM_NAME=Light and Salt
NEWSLETTER_UNSUBSCRIBE_SECRET=
