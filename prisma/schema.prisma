// Light and Salt — Prisma schema
// Phase 0: Profile + Role only. Future models are reserved as TODO comments
// below and will be introduced incrementally in later phases.
//
// TODO Phase 1: the seam between Supabase Auth and this schema is NOT enforced
// in code yet. The following plumbing must land in `supabase/migrations/0000_init.sql`
// before any sign-up flow ships (see `supabase/README.md` for the full
// migration text):
//   * FK from public.profiles.id to auth.users(id) on delete cascade
//   * `on_auth_user_created` trigger that inserts the profile row
//   * `on_auth_user_updated` trigger that mirrors email changes (the
//     `email String @unique` column below is a cached mirror of auth.users.email)
//   * RLS enabled on public.profiles plus owner-scoped read/update policies
// Without these, the first sign-up produces an auth.users row with no
// matching profile and every role helper silently resolves to false.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model Profile {
  // The Profile.id is the same UUID as Supabase auth.users.id. We mirror
  // Supabase's auth user into this row so app data can FK to a stable id
  // without joining across schemas.
  id          String   @id @db.Uuid
  email       String   @unique
  displayName String?
  avatarUrl   String?
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testimonies Testimony[]
  prayerRequests    PrayerRequest[]      @relation("ProfilePrayerRequests")
  prayerIntercessions PrayerIntercession[] @relation("ProfilePrayerIntercessions")

  @@index([role])
  @@map("profiles")
}

enum TestimonyStatus {
  PENDING
  APPROVED
  NEEDS_REVISION
  REJECTED
  FEATURED
}

model Testimony {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  content      String
  excerpt      String
  authorId     String          @db.Uuid
  status       TestimonyStatus @default(PENDING)
  featured     Boolean         @default(false)
  revisionNote String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  publishedAt  DateTime?

  author Profile @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([authorId])
  @@map("testimonies")
}

// ---------------------------------------------------------------------------
// Prayer Wall models
// ---------------------------------------------------------------------------

enum PrayerRequestStatus {
  PENDING
  APPROVED
  ANSWERED
  REJECTED
}

enum PrayerVisibility {
  PUBLIC
  ANONYMOUS
  PRIVATE
}

model PrayerRequest {
  id          String              @id @default(cuid())
  title       String
  content     String
  authorId    String              @db.Uuid
  status      PrayerRequestStatus @default(PENDING)
  visibility  PrayerVisibility    @default(PUBLIC)
  prayerCount Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  answeredAt  DateTime?

  author       Profile              @relation("ProfilePrayerRequests", fields: [authorId], references: [id])
  intercessions PrayerIntercession[]

  @@index([status])
  @@index([authorId])
  @@map("prayer_requests")
}

model PrayerIntercession {
  id              String   @id @default(cuid())
  prayerRequestId String
  userId          String   @db.Uuid
  createdAt       DateTime @default(now())

  prayerRequest PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  user          Profile       @relation("ProfilePrayerIntercessions", fields: [userId], references: [id])

  @@unique([prayerRequestId, userId])
  @@map("prayer_intercessions")
}

