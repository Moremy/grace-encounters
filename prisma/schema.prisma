// Grace Encounters — Prisma schema
// Phase 0: Profile + Role only. Future models are reserved as TODO comments
// below and will be introduced incrementally in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model Profile {
  // The Profile.id is the same UUID as Supabase auth.users.id. We mirror
  // Supabase's auth user into this row so app data can FK to a stable id
  // without joining across schemas.
  id          String   @id @db.Uuid
  email       String   @unique
  displayName String?
  avatarUrl   String?
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([role])
  @@map("profiles")
}

