// Light and Salt — Prisma schema
// Phase 0: Profile + Role only. Future models are reserved as TODO comments
// below and will be introduced incrementally in later phases.
//
// TODO Phase 1: the seam between Supabase Auth and this schema is NOT enforced
// in code yet. The following plumbing must land in `supabase/migrations/0000_init.sql`
// before any sign-up flow ships (see `supabase/README.md` for the full
// migration text):
//   * FK from public.profiles.id to auth.users(id) on delete cascade
//   * `on_auth_user_created` trigger that inserts the profile row
//   * `on_auth_user_updated` trigger that mirrors email changes (the
//     `email String @unique` column below is a cached mirror of auth.users.email)
//   * RLS enabled on public.profiles plus owner-scoped read/update policies
// Without these, the first sign-up produces an auth.users row with no
// matching profile and every role helper silently resolves to false.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum GroupCategory {
  PRAYER
  BIBLE_STUDY
  WORSHIP
  FELLOWSHIP
  OUTREACH
  YOUTH
  WOMEN
  MEN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum BlogCategory {
  DEVOTIONAL_THOUGHT
  FAITH_LIVING
  TESTIMONY_REFLECTION
  CHURCH_NEWS
  MISSIONS
  PRAYER
}

enum BlogArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum NotificationType {
  PRAYER_REPLY
  TESTIMONY_APPROVED
  GROUP_INVITATION
  EVENT_REMINDER
  GENERAL
}

model Profile {
  // The Profile.id is the same UUID as Supabase auth.users.id. We mirror
  // Supabase's auth user into this row so app data can FK to a stable id
  // without joining across schemas.
  id          String   @id @db.Uuid
  email       String   @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testimonies Testimony[]
  prayerRequests    PrayerRequest[]      @relation("ProfilePrayerRequests")
  prayerIntercessions PrayerIntercession[] @relation("ProfilePrayerIntercessions")
  devotionals Devotional[]
  communityGroupMembers CommunityGroupMember[]
  groupDiscussions      GroupDiscussion[]
  groupDiscussionReplies GroupDiscussionReply[]
  events                Event[]
  blogArticles          BlogArticle[]
  notifications         Notification[]

  @@index([role])
  @@map("profiles")
}

enum TestimonyStatus {
  PENDING
  APPROVED
  NEEDS_REVISION
  REJECTED
  FEATURED
}

model Testimony {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  content      String
  excerpt      String
  authorId     String          @db.Uuid
  status       TestimonyStatus @default(PENDING)
  featured     Boolean         @default(false)
  revisionNote String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  publishedAt  DateTime?

  author Profile @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([authorId])
  @@map("testimonies")
}

// ---------------------------------------------------------------------------
// Prayer Wall models
// ---------------------------------------------------------------------------

enum PrayerRequestStatus {
  PENDING
  APPROVED
  ANSWERED
  REJECTED
}

enum PrayerVisibility {
  PUBLIC
  ANONYMOUS
  PRIVATE
}

model PrayerRequest {
  id          String              @id @default(cuid())
  title       String
  content     String
  authorId    String              @db.Uuid
  status      PrayerRequestStatus @default(PENDING)
  visibility  PrayerVisibility    @default(PUBLIC)
  prayerCount Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  answeredAt  DateTime?

  author       Profile              @relation("ProfilePrayerRequests", fields: [authorId], references: [id])
  intercessions PrayerIntercession[]

  @@index([status])
  @@index([authorId])
  @@map("prayer_requests")
}

model PrayerIntercession {
  id              String   @id @default(cuid())
  prayerRequestId String
  userId          String   @db.Uuid
  createdAt       DateTime @default(now())

  prayerRequest PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  user          Profile       @relation("ProfilePrayerIntercessions", fields: [userId], references: [id])

  @@unique([prayerRequestId, userId])
  @@map("prayer_intercessions")
}

// ---------------------------------------------------------------------------
// Devotional models
// ---------------------------------------------------------------------------

enum DevotionalStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model Devotional {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  content            String
  scripture          String           // The actual Bible verse text
  scriptureReference String           // e.g. "Psalm 46:10"
  excerpt            String
  authorId           String           @db.Uuid
  status             DevotionalStatus @default(DRAFT)
  featured           Boolean          @default(false)
  publishDate        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  author Profile @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([authorId])
  @@index([publishDate])
  @@map("devotionals")
}

// ---------------------------------------------------------------------------
// Community Groups models
// ---------------------------------------------------------------------------

model CommunityGroup {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  category    GroupCategory
  imageUrl    String?
  memberCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members     CommunityGroupMember[]
  discussions GroupDiscussion[]

  @@map("community_groups")
}

model CommunityGroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String   @db.Uuid
  joinedAt DateTime @default(now())

  group CommunityGroup @relation(fields: [groupId], references: [id])
  user  Profile        @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("community_group_members")
}

model GroupDiscussion {
  id             String   @id @default(cuid())
  groupId        String
  authorId       String   @db.Uuid
  title          String
  content        String
  isPrayerThread Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group   CommunityGroup       @relation(fields: [groupId], references: [id])
  author  Profile              @relation(fields: [authorId], references: [id])
  replies GroupDiscussionReply[]

  @@map("group_discussions")
}

model GroupDiscussionReply {
  id           String   @id @default(cuid())
  discussionId String
  authorId     String   @db.Uuid
  content      String
  createdAt    DateTime @default(now())

  discussion GroupDiscussion @relation(fields: [discussionId], references: [id])
  author     Profile         @relation(fields: [authorId], references: [id])

  @@map("group_discussion_replies")
}

// ---------------------------------------------------------------------------
// Events model
// ---------------------------------------------------------------------------

model Event {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String
  location    String
  date        DateTime
  endDate     DateTime?
  imageUrl    String?
  featured    Boolean     @default(false)
  status      EventStatus @default(DRAFT)
  createdById String      @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy Profile @relation(fields: [createdById], references: [id])

  @@index([status])
  @@index([date])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Blog Articles model
// ---------------------------------------------------------------------------

model BlogArticle {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  content     String
  excerpt     String
  category    BlogCategory
  imageUrl    String?
  featured    Boolean           @default(false)
  authorId    String            @db.Uuid
  status      BlogArticleStatus @default(DRAFT)
  publishDate DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  author Profile @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([authorId])
  @@index([category])
  @@map("blog_articles")
}

// ---------------------------------------------------------------------------
// Notifications model
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user Profile @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@map("notifications")
}
