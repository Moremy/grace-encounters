// Light and Salt — Prisma schema
// Phase 0: Profile + Role only. Future models are reserved as TODO comments
// below and will be introduced incrementally in later phases.
//
// TODO Phase 1: the seam between Supabase Auth and this schema is NOT enforced
// in code yet. The following plumbing must land in `supabase/migrations/0000_init.sql`
// before any sign-up flow ships (see `supabase/README.md` for the full
// migration text):
//   * FK from public.profiles.id to auth.users(id) on delete cascade
//   * `on_auth_user_created` trigger that inserts the profile row
//   * `on_auth_user_updated` trigger that mirrors email changes (the
//     `email String @unique` column below is a cached mirror of auth.users.email)
//   * RLS enabled on public.profiles plus owner-scoped read/update policies
// Without these, the first sign-up produces an auth.users row with no
// matching profile and every role helper silently resolves to false.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum GroupCategory {
  PRAYER
  BIBLE_STUDY
  WORSHIP
  FELLOWSHIP
  OUTREACH
  YOUTH
  WOMEN
  MEN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum BlogCategory {
  DEVOTIONAL_THOUGHT
  FAITH_LIVING
  TESTIMONY_REFLECTION
  CHURCH_NEWS
  MISSIONS
  PRAYER
}

enum BlogArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum NotificationType {
  PRAYER_REPLY
  TESTIMONY_APPROVED
  GROUP_INVITATION
  EVENT_REMINDER
  GENERAL
  MESSAGE_RECEIVED
  DONATION_RECEIVED
  PRAYER_ROOM_STARTING
  BIBLE_STUDY_REMINDER
  TESTIMONY_FEATURED
  SERMON_PUBLISHED
}

// ---------------------------------------------------------------------------
// Testimony enums
// ---------------------------------------------------------------------------

enum TestimonyMediaType {
  TEXT
  PDF
  AUDIO
  VIDEO
}

enum TestimonyCategory {
  HEALING
  SALVATION
  DELIVERANCE
  PROVISION
  RESTORATION
  FAITH
  OTHER
}

// ---------------------------------------------------------------------------
// Media Library enums
// ---------------------------------------------------------------------------

enum MediaType {
  SERMON_AUDIO
  SERMON_VIDEO
  WORSHIP_AUDIO
  VIDEO_MESSAGE
  PDF_RESOURCE
}

enum MediaCategory {
  SERMON
  WORSHIP
  TEACHING
  TESTIMONY
  CONFERENCE
}

// ---------------------------------------------------------------------------
// Donations enums
// ---------------------------------------------------------------------------

enum PaymentProvider {
  STRIPE
  MPESA
  PAYPAL
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Messaging enums
// ---------------------------------------------------------------------------

enum MessageMediaType {
  IMAGE
  FILE
  AUDIO
}

enum ConversationType {
  DIRECT
  GROUP
}

model Profile {
  // The Profile.id is the same UUID as Supabase auth.users.id. We mirror
  // Supabase's auth user into this row so app data can FK to a stable id
  // without joining across schemas.
  id          String   @id @db.Uuid
  email       String   @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testimonies Testimony[]
  prayerRequests    PrayerRequest[]      @relation("ProfilePrayerRequests")
  prayerIntercessions PrayerIntercession[] @relation("ProfilePrayerIntercessions")
  devotionals Devotional[]
  communityGroupMembers CommunityGroupMember[]
  groupDiscussions      GroupDiscussion[]
  groupDiscussionReplies GroupDiscussionReply[]
  events                Event[]
  blogArticles          BlogArticle[]
  notifications         Notification[]

  // Media & Sermon relations
  mediaItems            MediaItem[]          @relation("ProfileMediaItems")
  sermons               Sermon[]             @relation("ProfileSermons")

  // Prayer Room relations
  createdPrayerRooms    PrayerRoom[]         @relation("ProfileCreatedPrayerRooms")
  prayerRoomParticipants PrayerRoomParticipant[]
  prayerRoomMessages    PrayerRoomMessage[]

  // Bible Study relations
  createdBibleStudyPlans BibleStudyPlan[]
  bibleStudyProgress    BibleStudyProgress[]
  scriptureBookmarks    ScriptureBookmark[]

  // Donation relations
  donations             Donation[]

  // Messaging relations
  messages              Message[]
  conversationParticipants ConversationParticipant[]

  // Push notification relations
  pushSubscriptions     PushSubscription[]

  // AI recommendation relations
  aiRecommendations     AIRecommendation[]

  // Live Streaming relations
  liveStreams            LiveStream[]         @relation("ProfileLiveStreams")
  liveStreamChats       LiveStreamChat[]     @relation("ProfileLiveStreamChats")

  @@index([role])
  @@map("profiles")
}

enum TestimonyStatus {
  PENDING
  APPROVED
  NEEDS_REVISION
  REJECTED
  FEATURED
}

model Testimony {
  id           String            @id @default(cuid())
  slug         String            @unique
  title        String
  content      String
  excerpt      String
  authorId     String            @db.Uuid
  status       TestimonyStatus   @default(PENDING)
  featured     Boolean           @default(false)
  revisionNote String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  publishedAt  DateTime?

  // Media & categorization extensions
  mediaType    TestimonyMediaType @default(TEXT)
  mediaUrl     String?
  thumbnailUrl String?
  category     TestimonyCategory?
  tags         String[]
  fileSize     Int?

  author Profile @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([authorId])
  @@index([category])
  @@index([mediaType])
  @@map("testimonies")
}

// ---------------------------------------------------------------------------
// Prayer Wall models
// ---------------------------------------------------------------------------

enum PrayerRequestStatus {
  PENDING
  APPROVED
  ANSWERED
  REJECTED
}

enum PrayerVisibility {
  PUBLIC
  ANONYMOUS
  PRIVATE
}

model PrayerRequest {
  id          String              @id @default(cuid())
  title       String
  content     String
  authorId    String              @db.Uuid
  status      PrayerRequestStatus @default(PENDING)
  visibility  PrayerVisibility    @default(PUBLIC)
  prayerCount Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  answeredAt  DateTime?

  author       Profile              @relation("ProfilePrayerRequests", fields: [authorId], references: [id])
  intercessions PrayerIntercession[]

  @@index([status])
  @@index([authorId])
  @@map("prayer_requests")
}

model PrayerIntercession {
  id              String   @id @default(cuid())
  prayerRequestId String
  userId          String   @db.Uuid
  createdAt       DateTime @default(now())

  prayerRequest PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  user          Profile       @relation("ProfilePrayerIntercessions", fields: [userId], references: [id])

  @@unique([prayerRequestId, userId])
  @@map("prayer_intercessions")
}

// ---------------------------------------------------------------------------
// Devotional models
// ---------------------------------------------------------------------------

enum DevotionalStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model Devotional {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  content            String
  scripture          String           // The actual Bible verse text
  scriptureReference String           // e.g. "Psalm 46:10"
  excerpt            String
  authorId           String           @db.Uuid
  status             DevotionalStatus @default(DRAFT)
  featured           Boolean          @default(false)
  publishDate        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  author Profile @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([authorId])
  @@index([publishDate])
  @@map("devotionals")
}

// ---------------------------------------------------------------------------
// Community Groups models
// ---------------------------------------------------------------------------

model CommunityGroup {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  category    GroupCategory
  imageUrl    String?
  memberCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members     CommunityGroupMember[]
  discussions GroupDiscussion[]

  @@map("community_groups")
}

model CommunityGroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String   @db.Uuid
  joinedAt DateTime @default(now())

  group CommunityGroup @relation(fields: [groupId], references: [id])
  user  Profile        @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("community_group_members")
}

model GroupDiscussion {
  id             String   @id @default(cuid())
  groupId        String
  authorId       String   @db.Uuid
  title          String
  content        String
  isPrayerThread Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group   CommunityGroup       @relation(fields: [groupId], references: [id])
  author  Profile              @relation(fields: [authorId], references: [id])
  replies GroupDiscussionReply[]

  @@map("group_discussions")
}

model GroupDiscussionReply {
  id           String   @id @default(cuid())
  discussionId String
  authorId     String   @db.Uuid
  content      String
  createdAt    DateTime @default(now())

  discussion GroupDiscussion @relation(fields: [discussionId], references: [id])
  author     Profile         @relation(fields: [authorId], references: [id])

  @@map("group_discussion_replies")
}

// ---------------------------------------------------------------------------
// Events model
// ---------------------------------------------------------------------------

model Event {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String
  location    String
  date        DateTime
  endDate     DateTime?
  imageUrl    String?
  featured    Boolean     @default(false)
  status      EventStatus @default(DRAFT)
  createdById String      @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy Profile @relation(fields: [createdById], references: [id])

  @@index([status])
  @@index([date])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Blog Articles model
// ---------------------------------------------------------------------------

model BlogArticle {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  content     String
  excerpt     String
  category    BlogCategory
  imageUrl    String?
  featured    Boolean           @default(false)
  authorId    String            @db.Uuid
  status      BlogArticleStatus @default(DRAFT)
  publishDate DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  author Profile @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([authorId])
  @@index([category])
  @@map("blog_articles")
}

// ---------------------------------------------------------------------------
// Notifications model
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user Profile @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Media Library models
// ---------------------------------------------------------------------------

model MediaPlaylist {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String
  coverImageUrl String?
  category      MediaCategory
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items MediaItem[]

  @@map("media_playlists")
}

model MediaItem {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  description  String
  mediaType    MediaType
  url          String
  thumbnailUrl String?
  duration     Int?
  fileSize     Int?
  category     MediaCategory
  playlistId   String?
  featured     Boolean       @default(false)
  speakerId    String?       @db.Uuid
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  playlist MediaPlaylist? @relation(fields: [playlistId], references: [id])
  speaker  Profile?       @relation("ProfileMediaItems", fields: [speakerId], references: [id])

  @@index([mediaType])
  @@index([category])
  @@index([featured])
  @@index([publishedAt])
  @@index([speakerId])
  @@map("media_items")
}

// ---------------------------------------------------------------------------
// Sermons models
// ---------------------------------------------------------------------------

model SermonSeries {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String
  coverImageUrl String?
  order         Int
  createdAt     DateTime @default(now())

  sermons Sermon[]

  @@map("sermon_series")
}

model Sermon {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String
  scripture     String?
  seriesId      String?
  speakerId     String    @db.Uuid
  audioUrl      String?
  videoUrl      String?
  transcriptUrl String?
  notesUrl      String?
  thumbnailUrl  String?
  duration      Int?
  featured      Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  series  SermonSeries? @relation(fields: [seriesId], references: [id])
  speaker Profile       @relation("ProfileSermons", fields: [speakerId], references: [id])

  @@index([seriesId])
  @@index([speakerId])
  @@index([featured])
  @@index([publishedAt])
  @@map("sermons")
}

// ---------------------------------------------------------------------------
// Live Prayer Room models
// ---------------------------------------------------------------------------

model PrayerRoom {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String
  scheduledAt     DateTime?
  endAt           DateTime?
  isLive          Boolean   @default(false)
  createdById     String    @db.Uuid
  maxParticipants Int       @default(50)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy    Profile                @relation("ProfileCreatedPrayerRooms", fields: [createdById], references: [id])
  participants PrayerRoomParticipant[]
  messages     PrayerRoomMessage[]

  @@index([isLive])
  @@index([scheduledAt])
  @@index([createdById])
  @@map("prayer_rooms")
}

model PrayerRoomParticipant {
  id       String   @id @default(cuid())
  roomId   String
  userId   String   @db.Uuid
  joinedAt DateTime @default(now())

  room PrayerRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user Profile    @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@map("prayer_room_participants")
}

model PrayerRoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  authorId  String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  room   PrayerRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author Profile    @relation(fields: [authorId], references: [id])

  @@index([roomId])
  @@index([authorId])
  @@map("prayer_room_messages")
}

// ---------------------------------------------------------------------------
// Bible Study models
// ---------------------------------------------------------------------------

model BibleStudyPlan {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String
  coverImageUrl String?
  totalDays     Int
  createdById   String   @db.Uuid
  createdAt     DateTime @default(now())

  createdBy Profile            @relation(fields: [createdById], references: [id])
  days      BibleStudyDay[]
  progress  BibleStudyProgress[]

  @@index([createdById])
  @@map("bible_study_plans")
}

model BibleStudyDay {
  id                 String   @id @default(cuid())
  planId             String
  dayNumber          Int
  title              String
  scripture          String
  scriptureReference String
  reflection         String?
  createdAt          DateTime @default(now())

  plan BibleStudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("bible_study_days")
}

model BibleStudyProgress {
  id          String    @id @default(cuid())
  planId      String
  userId      String    @db.Uuid
  dayNumber   Int
  completed   Boolean   @default(false)
  notes       String?
  completedAt DateTime?

  plan BibleStudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user Profile        @relation(fields: [userId], references: [id])

  @@unique([planId, userId, dayNumber])
  @@index([planId])
  @@index([userId])
  @@map("bible_study_progress")
}

model ScriptureBookmark {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  reference String
  content   String?
  note      String?
  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("scripture_bookmarks")
}

// ---------------------------------------------------------------------------
// Donations models
// ---------------------------------------------------------------------------

model DonationCampaign {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String
  goalAmount    Decimal
  currentAmount Decimal  @default(0)
  imageUrl      String?
  active        Boolean  @default(true)
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime @default(now())

  donations Donation[]

  @@index([active])
  @@map("donation_campaigns")
}

model Donation {
  id                    String         @id @default(cuid())
  donorId               String         @db.Uuid
  amount                Decimal
  currency              String         @default("USD")
  provider              PaymentProvider
  providerTransactionId String?
  campaignId            String?
  status                DonationStatus @default(PENDING)
  recurring             Boolean        @default(false)
  recurringInterval     String?
  createdAt             DateTime       @default(now())

  donor    Profile           @relation(fields: [donorId], references: [id])
  campaign DonationCampaign? @relation(fields: [campaignId], references: [id])

  @@index([donorId])
  @@index([campaignId])
  @@index([status])
  @@map("donations")
}

// ---------------------------------------------------------------------------
// Messaging models
// ---------------------------------------------------------------------------

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType
  title     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         Profile      @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  senderId       String           @db.Uuid
  content        String
  mediaUrl       String?
  mediaType      MessageMediaType?
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Push Subscription models
// ---------------------------------------------------------------------------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// AI Recommendation models
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Live Streaming enums
// ---------------------------------------------------------------------------

enum LiveStreamStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum LiveStreamType {
  WORSHIP
  SERMON
  EVENT
  SPECIAL
}

enum AIRecommendationType {
  SCRIPTURE
  DEVOTIONAL
  CONTENT
}

model AIRecommendation {
  id        String               @id @default(cuid())
  userId    String               @db.Uuid
  type      AIRecommendationType
  content   Json
  createdAt DateTime             @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("ai_recommendations")
}

// ---------------------------------------------------------------------------
// Live Streaming models
// ---------------------------------------------------------------------------

model LiveStream {
  id           String           @id @default(cuid())
  slug         String           @unique
  title        String
  description  String
  streamUrl    String?
  thumbnailUrl String?
  status       LiveStreamStatus @default(SCHEDULED)
  streamType   LiveStreamType
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  viewerCount  Int              @default(0)
  createdById  String           @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  createdBy Profile           @relation("ProfileLiveStreams", fields: [createdById], references: [id])
  chatMessages LiveStreamChat[]
  replay       LiveStreamReplay?

  @@index([status])
  @@index([streamType])
  @@index([scheduledAt])
  @@index([createdById])
  @@map("live_streams")
}

model LiveStreamChat {
  id        String   @id @default(cuid())
  streamId  String
  authorId  String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  author Profile    @relation("ProfileLiveStreamChats", fields: [authorId], references: [id])

  @@index([streamId])
  @@index([authorId])
  @@map("live_stream_chats")
}

model LiveStreamReplay {
  id        String   @id @default(cuid())
  streamId  String   @unique
  replayUrl String
  duration  Int?
  createdAt DateTime @default(now())

  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@map("live_stream_replays")
}
